NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/sctracker
LOG_LEVEL=info

# Development-only header auth. Must remain false in production.
DEV_AUTH_ENABLED=false

WORKER_POLL_MS=2000

AWS_REGION=eu-central-1
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_OBJECT_LOCK_REQUIRED=true

SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
SENTINEL_HUB_BASE_URL=https://services.sentinel-hub.com

EU_IS_BASE_URL=
EU_IS_CLIENT_ID=
EU_IS_CLIENT_SECRET=
